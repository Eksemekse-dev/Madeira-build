name: Build Madeira IPA

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Checkout repository with submodules
        uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: Set up Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Run build scripts
        run: |
          chmod +x build/*/*.sh 2>/dev/null || true
          for script in build/*/*.sh; do
            if [ -f "$script" ]; then
              echo "Executing $script..."
              "$script" || true
            fi
          done

      - name: Build with xcodebuild
        run: |
          # Znajdź plik .xcodeproj lub .xcworkspace w projekcie
          PROJ=$(find . -maxdepth 2 -name "*.xcodeproj" -o -name "*.xcworkspace" | head -n 1)
          echo "Found project at: $PROJ"
          
          if [[ "$PROJ" == *.xcworkspace ]]; then
            xcodebuild -workspace "$PROJ" -scheme Madeira -configuration Release -sdk iphoneos CODE_SIGNING_ALLOWED=NO build
          elif [[ "$PROJ" == *.xcodeproj ]]; then
            xcodebuild -project "$PROJ" -scheme Madeira -configuration Release -sdk iphoneos CODE_SIGNING_ALLOWED=NO build
          else
            echo "No Xcode project found!" && exit 1
          fi

      - name: Create IPA Package
        run: |
          mkdir -p Payload
          find . -type d -name "*.app" -exec cp -R {} Payload/ \;
          zip -r Madeira.ipa Payload

      - name: Upload IPA Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Madeira-IPA
          path: Madeira.ipa
